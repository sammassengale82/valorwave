{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.samma.valorwave",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "security": {
      "csp": null
    },

    "windows": [
    {
      "label": "main",
      "title": "ValorWave",
      "url": "index.html#/",
      "width": 1280,
      "height": 720,
      "resizable": true,
      "decorations": true,
      "fullscreen": false
    }
  ]

  }, 

    "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  }
